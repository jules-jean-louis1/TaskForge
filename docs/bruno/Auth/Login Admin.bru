meta {
  name: Login Admin User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin.admin@example.com",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.body.token) {
    bru.setEnvVar("token", res.body.token);
    bru.setEnvVar("token_admin", res.body.token);
  }
}